# ---------------------------------------------------------------------------
# EllaDay Homes · variables de entorno
# Copia este archivo a .env.local para desarrollo. En producción configúralas
# en Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://mmlbslwljvmscbgsqkkq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave "service_role": SOLO en el servidor. Nunca la expongas ni la subas a git.
SUPABASE_SERVICE_ROLE_KEY=

# Panel de administración (/admin): una clave por persona.
ADMIN_PASSWORD_DAYANA=
ADMIN_PASSWORD_ELLA=
# Opcional: secreto para firmar la sesión. Si se omite se deriva de las claves.
ADMIN_SESSION_SECRET=

# Traducción automática ES → EN/FR/DE al publicar (console.anthropic.com)
ANTHROPIC_API_KEY=
